# Copy to .env and fill in. Never commit .env.

# --------------------------------------------------------------------------
# Django
# --------------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Only relevant when DJANGO_DEBUG=False and the app sits behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Defaults to SQLite in the project root. Point at Postgres if you'd rather:
#   DATABASE_URL=postgres://user:password@localhost:5432/oneapp
# A hosted Postgres needs TLS, which travels in the URL:
#   DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL=

# How long a Postgres connection is reused. Ignored on SQLite.
DJANGO_CONN_MAX_AGE=600

# --------------------------------------------------------------------------
# Deployment
# --------------------------------------------------------------------------
# Set these only where the app really runs behind a TLS-terminating proxy and
# the static files were collected by the build.
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_STATIC_MANIFEST=False

# --------------------------------------------------------------------------
# Fuel module
# --------------------------------------------------------------------------
# Overpass mirrors, tried in order. The public instances rate-limit, so the
# importer backs off and moves down the list rather than hammering one.
OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT=180

# A pump price you logged stops counting as current after this many days.
PRICE_FRESH_DAYS=14

# Ceiling on stations returned for one map viewport.
MAP_MAX_STATIONS=300

# Browser basemap tiles. Defaults to CARTO's OSM-derived Positron layer, which
# avoids direct dependence on tile.openstreetmap.org when that service returns 403.
MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO
MAP_TILE_MAX_ZOOM=19
